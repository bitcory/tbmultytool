{
  "manifest_version": 3,
  "name": "TB MTOOL Companion",
  "version": "0.1.57",
  "description": "TB MTOOL 앱의 생성 작업(ChatGPT·Grok·Suno 등)을 사용자 크롬에서 자동 실행하고, 결과를 앱으로 보냅니다 (로컬 전용).",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://labs.google/*",
    "https://flow-content.google/*",
    "https://*.flow-content.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://*.gstatic.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://*.x.ai/*",
    "https://suno.com/*",
    "https://*.suno.com/*",
    "https://*.suno.ai/*",
    "https://www.coupang.com/*",
    "https://*.coupang.com/*",
    "https://*.coupangcdn.com/*",
    "https://link.coupang.com/*",
    "https://partners.coupang.com/*",
    "https://runway.com/*",
    "https://app.runway.com/*",
    "https://runwayml.com/*",
    "https://app.runwayml.com/*",
    "https://www.xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "automate.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "grok.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suno.com/*"
      ],
      "js": [
        "suno.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "exclude_matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "flow.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "exclude_matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "flow-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "flowengine/fe-flow-options.js",
        "flowengine/fe-controller.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "flowengine/fe-slate-helper.js",
        "flowengine/fe-drop-handler.js",
        "flowengine/fe-page-script.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.coupang.com/vp/products/*",
        "https://*.coupang.com/vp/products/*"
      ],
      "js": [
        "coupang.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://runway.com/*",
        "https://app.runway.com/*",
        "https://runwayml.com/*",
        "https://app.runwayml.com/*"
      ],
      "js": [
        "runwayengine/re-controller.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ],
      "js": [
        "xiaohongshu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://link.inpock.co.kr/*"
      ],
      "js": [
        "inpock.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TB MTOOL Companion"
  }
}
